# Dev proxy target for /api and /sanctum (server-side only, not exposed to the bundle)
KEYSTONE_API_PROXY=http://localhost:8000

# Realtime (Laravel Reverb). Leave VITE_REVERB_APP_KEY empty to run without a socket;
# the app then falls back to polling for notifications.
VITE_REVERB_APP_KEY=keystone-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
