{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keystone-erp.invalid/contracts/sync/pull.request.schema.json",
  "title": "POST /api/v1/sync/pull isteği",
  "description": "Kaynak başına cursor ile artımlı okuma. Şirket X-Company-Id başlığından gelir. Aynı kaynak bir istekte birden fazla geçemez (sunucu VALIDATION_ERROR döner).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "cursor"],
        "properties": {
          "resource": { "$ref": "common.schema.json#/$defs/resourceName" },
          "cursor": {
            "description": "null: kaynağın ilk (tam) indirmesi.",
            "anyOf": [{ "$ref": "common.schema.json#/$defs/cursor" }, { "type": "null" }]
          },
          "limit": {
            "description": "Sayfa boyutu; verilmezse limits.pull_page_default, en fazla limits.pull_page_max.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    }
  }
}
