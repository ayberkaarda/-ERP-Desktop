{
  "name": "@keystone/desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:desktop": "vite --config vite.desktop.config.ts",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.ts",
    "build": "npm run build:desktop",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/check-desktop-i18n.mjs",
    "wire:ts": "sh scripts/check-wire-ts.sh",
    "wire:gen": "node scripts/gen-wire-ts.mjs",
    "e2e": "node --test --test-concurrency=1 \"e2e/*.e2e.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "i18next": "^26.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
