{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shell skeleton permissions of the main window. fs, http, dialog and the D5/D6 plugins are not granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:allow-platform",
    "process:allow-restart",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
