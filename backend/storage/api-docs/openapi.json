{
    "openapi": "3.1.2",
    "info": {
        "title": "Keystone API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "operationId": "health",
                "summary": "Liveness probe",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "const": "ok"
                                                }
                                            },
                                            "required": [
                                                "status"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorCode": {
                "type": "string",
                "enum": [
                    "VALIDATION_ERROR",
                    "UNAUTHENTICATED",
                    "FORBIDDEN",
                    "NOT_FOUND",
                    "METHOD_NOT_ALLOWED",
                    "TOO_MANY_ATTEMPTS",
                    "HTTP_ERROR",
                    "SERVER_ERROR",
                    "VERSION_CONFLICT",
                    "IDEMPOTENCY_KEY_REQUIRED",
                    "IDEMPOTENCY_KEY_REUSED",
                    "IDEMPOTENCY_IN_PROGRESS",
                    "COMPANY_REQUIRED",
                    "COMPANY_FORBIDDEN",
                    "TWO_FACTOR_REQUIRED",
                    "INVALID_TWO_FACTOR_CODE",
                    "PASSWORD_CHANGE_REQUIRED",
                    "USER_DEACTIVATED",
                    "INVALID_STATE_TRANSITION",
                    "APPROVAL_REQUIRED",
                    "FILE_TOO_LARGE",
                    "UNSUPPORTED_FILE_TYPE"
                ],
                "title": "ErrorCode"
            },
            "ErrorEnvelope": {
                "type": "object",
                "properties": {
                    "errors": {
                        "type": "object",
                        "properties": {
                            "message": {
                                "type": "string"
                            },
                            "code": {
                                "$ref": "#/components/schemas/ErrorCode"
                            },
                            "fields": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "required": [
                            "message",
                            "code"
                        ]
                    }
                },
                "required": [
                    "errors"
                ],
                "title": "ErrorEnvelope"
            }
        }
    }
}