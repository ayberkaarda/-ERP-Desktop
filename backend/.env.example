APP_NAME=Keystone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=keystone
DB_USERNAME=keystone
DB_PASSWORD=keystone

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=keystone

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@keystone.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=keystone
AWS_SECRET_ACCESS_KEY=keystone-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=keystone
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=keystone
REVERB_APP_KEY=keystone-key
REVERB_APP_SECRET=keystone-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

ASSISTANT_ENABLED=false

ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
ASSISTANT_MAX_STEPS=4
ASSISTANT_MAX_OUTPUT_TOKENS=2048
ASSISTANT_DAILY_TOKENS=1000000
ASSISTANT_TURN_TOKENS=200000
ASSISTANT_MASK_PII=true
ASSISTANT_RETENTION_DAYS=30

EDOCUMENTS_DRIVER=sandbox
EDOCUMENTS_JAVA_BINARY=java
