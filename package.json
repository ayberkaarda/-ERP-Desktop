{
  "name": "keystone-erp",
  "private": true,
  "workspaces": [
    "frontend",
    "desktop"
  ],
  "scripts": {
    "gen:api": "composer --working-dir=backend openapi && npm run gen:api --workspace frontend",
    "contracts:validate": "npm exec --yes --package=ajv@8.17.1 --package=ajv-formats@3.0.1 -- node contracts/scripts/validate.mjs"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  }
}
